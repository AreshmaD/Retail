[
  {
    "id": "CONV-01",
    "description": "Cross-agent memory: product mentioned in turn 1 resolved correctly in turns 2 and 3, across a specialist handoff",
    "turns": [
      {
        "query": "Recommend a dress under $80",
        "expect_products": true,
        "must_contain_any": ["dress"]
      },
      {
        "query": "Is the black midi dress in a medium?",
        "expect_products": false,
        "must_contain_any": ["out of stock", "medium"],
        "must_not_contain": ["which product", "product id", "which dress"]
      },
      {
        "query": "Is it available to pick up at Maple Grove?",
        "expect_products": false,
        "must_contain_any": ["maple grove"],
        "must_not_contain": ["which product", "which item", "what item"]
      }
    ]
  },
  {
    "id": "CONV-02",
    "description": "Recommendation context carried into a follow-up refinement",
    "turns": [
      {
        "query": "Show me some shoes",
        "expect_products": true,
        "must_contain_any": ["shoe"]
      },
      {
        "query": "What about something for hiking specifically?",
        "expect_products": true,
        "must_contain_any": ["hik"]
      }
    ]
  },
  {
    "id": "CONV-03",
    "description": "Topic switch mid-conversation: policy question after a product discussion, should not confuse contexts",
    "turns": [
      {
        "query": "Recommend a dress under $80",
        "expect_products": true,
        "must_contain_any": ["dress"]
      },
      {
        "query": "What's your return policy?",
        "expect_products": false,
        "must_contain_any": ["return", "day"],
        "must_not_contain": ["dress"]
      }
    ]
  }
]
